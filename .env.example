PORT=3001

# Banco Central (Supabase > Project Settings > API). Usar la clave anon/publishable, NUNCA la service_role.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=

# API Key de este cajero (la genera el panel del Banco Central al crear el cajero).
# Es la configuración por defecto; desde /admin se puede cambiar para una terminal.
BANCO_API_KEY=

# Acceso al panel administrativo del cajero (/admin)
ATM_ADMIN_USUARIO=admin
ATM_ADMIN_PASSWORD=
# Texto largo y aleatorio: firma la sesión y cifra la configuración de la terminal.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Reglas locales del cajero (valores por defecto; se pueden cambiar desde /admin)
ATM_MULTIPLO=100
ATM_RETIRO_MAXIMO=8000
ATM_DEPOSITO_MAXIMO=20000
